# /etc/systemd/system/bhavishya-api.service — the Django API (installed by setup-server.sh).
[Unit]
Description=Bhavishya PSCs API (Django + gunicorn)
After=network.target postgresql.service

[Service]
User=deploy
Group=www-data
WorkingDirectory=APP/backend
ExecStart=APP/backend/.venv/bin/gunicorn config.wsgi:application --workers 3 --bind 127.0.0.1:8000 --timeout 120 --access-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
