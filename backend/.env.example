# Copy to backend/.env and adjust.
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgres://bhavishya:bhavishya@localhost:5432/bhavishya
ALLOWED_HOSTS=localhost,127.0.0.1
# Set to true when served over HTTPS
COOKIE_SECURE=false
AUTH_TOKEN_TTL_DAYS=14
MATERIAL_MAX_UPLOAD_MB=25
IMAGE_MAX_UPLOAD_MB=5
DOWNLOAD_LINK_TTL_SECONDS=300
